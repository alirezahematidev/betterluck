{
  "$schema": "https://unpkg.com/release-it@21/schema/release-it.json",
  "git": {
    "requireBranch": "main",
    "requireCleanWorkingDir": true,
    "commitMessage": "chore(release): v${version}",
    "tagName": "v${version}",
    "tagAnnotation": "Release v${version}",
    "push": true
  },
  "github": {
    "release": true,
    "releaseName": "v${version}",
    "comments": {
      "submit": false
    }
  },
  "npm": {
    "publish": true
  },
  "hooks": {
    "before:init": ["pnpm -w run check"],
    "after:bump": ["pnpm run build", "pnpm run lint:package"]
  },
  "plugins": {
    "@release-it/conventional-changelog": {
      "infile": "CHANGELOG.md",
      "header": "# Changelog",
      "preset": {
        "name": "conventionalcommits"
      },
      "commitsOpts": {
        "path": "."
      }
    }
  }
}
