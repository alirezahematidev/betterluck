{
  "name": "betterluck",
  "version": "0.0.0",
  "description": "A physics-driven, fully themable prize / fortune wheel for React with RTL and Persian support.",
  "keywords": [
    "fortune-wheel",
    "persian",
    "physics",
    "prize-wheel",
    "react",
    "roulette",
    "rtl",
    "spin-wheel",
    "svg",
    "wheel",
    "wheel-of-fortune"
  ],
  "homepage": "https://alirezahematidev.github.io/fortune-wheel/",
  "bugs": {
    "url": "https://github.com/alirezahematidev/fortune-wheel/issues"
  },
  "license": "MIT",
  "author": "alirezahematidev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alirezahematidev/fortune-wheel.git",
    "directory": "packages/betterluck"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint:package": "publint --strict && attw --pack . --profile esm-only",
    "release": "release-it"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@release-it/conventional-changelog": "^12.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "conventional-changelog-conventionalcommits": "^10.4.1",
    "publint": "^0.3.25",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "release-it": "^21.1.3",
    "tsdown": "^0.23.7",
    "vitest": "^5.1.1"
  },
  "peerDependencies": {
    "react": ">=18.2.0",
    "react-dom": ">=18.2.0"
  },
  "engines": {
    "node": ">=18"
  }
}
